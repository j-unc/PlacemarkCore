<h1>User Administration</h1>

<table>
  <tr>
    <th>Email</th>
    <th>Role</th>
    <th>Action</th>
  </tr>

  {{#each users}}
    <tr>
      <td>{{email}}</td>
      <td>{{role}}</td>
      <td>
        <a href="/admin-overview/deleteUser/{{_id}}" onclick="return confirm('Delete this user? {{email}}');">Delete</a>
      </td>
    </tr>
  {{/each}}
</table>

